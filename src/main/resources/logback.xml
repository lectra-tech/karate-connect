<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--  Suppress logback's internal status messages  -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <!--  Console appender that writes to stderr (not stdout) for CLI compatibility  -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/karate.log</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.karatelabs" level="INFO"/>
    <logger name="karate.runtime" level="INFO"/>
    <logger name="karate.http" level="WARN"/>
    <logger name="karate.scenario" level="INFO"/>
    <logger name="com.lectra.karate.connect" level="INFO"/>

    <!-- Suppress noisy logs -->
    <logger name="io.netty" level="WARN"/>
    <logger name="ch.qos.logback" level="WARN"/>

    <root level="ERROR">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

</configuration>